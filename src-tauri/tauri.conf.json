{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatRadar",
  "version": "0.4.0",
  "identifier": "com.batradar.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../src/assets/icons/icon.ico"
